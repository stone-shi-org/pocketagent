{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "enabledManagers": ["custom.regex"],

  "customManagers": [
    {
      "customType": "regex",
      "description": "Claude Code image pin (docker/agent-versions.env). Installed by claude.ai/install.sh, which takes the same release number npm publishes.",
      "fileMatch": ["^docker/agent-versions\\.env$"],
      "matchStrings": ["CLAUDE_CODE_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "@anthropic-ai/claude-code",
      "datasourceTemplate": "npm",
      "groupName": "claude-code agent pin"
    },
    {
      "customType": "regex",
      "description": "Codex image pin (docker/agent-versions.env). Installed by chatgpt.com/codex/install.sh --release, which takes the same release number npm publishes.",
      "fileMatch": ["^docker/agent-versions\\.env$"],
      "matchStrings": ["CODEX_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "@openai/codex",
      "datasourceTemplate": "npm",
      "groupName": "codex agent pin"
    },
    {
      "customType": "regex",
      "description": "opencode image pin (docker/agent-versions.env). Installed by opencode.ai/v2/install --version, which takes the same release number npm publishes.",
      "fileMatch": ["^docker/agent-versions\\.env$"],
      "matchStrings": ["OPENCODE_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "@opencode/cli",
      "datasourceTemplate": "npm",
      "groupName": "opencode agent pin"
    },
    {
      "customType": "regex",
      "description": "playwright-cli pin for the `all` image (docker/agent-versions.env). The Chromium revision follows from the playwright-core the CLI bundles.",
      "fileMatch": ["^docker/agent-versions\\.env$"],
      "matchStrings": ["PLAYWRIGHT_CLI_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "@playwright/cli",
      "datasourceTemplate": "npm",
      "groupName": "playwright-cli pin"
    }
  ],

  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 4
}
