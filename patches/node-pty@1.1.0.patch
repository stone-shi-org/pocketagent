+// Ensure prebuilt spawn-helper is executable on macOS / Unix
+const prebuildsDir = path.join(__dirname, '../prebuilds');
+if (fs.existsSync(prebuildsDir)) {
+  for (const dir of fs.readdirSync(prebuildsDir)) {
+    const helper = path.join(prebuildsDir, dir, 'spawn-helper');
+    if (fs.existsSync(helper)) {
+      try { fs.chmodSync(helper, 0o755); } catch {}
+    }
+  }
+}
+const releaseHelper = path.join(RELEASE_DIR, 'spawn-helper');
+if (fs.existsSync(releaseHelper)) {
+  try { fs.chmodSync(releaseHelper, 0o755); } catch {}
+}
+
 process.exit(0);
