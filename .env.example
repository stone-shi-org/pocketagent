# PocketAgent configuration
# Copy to `.env` and edit. Never commit the real file.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Loopback by default. PocketAgent grants terminal access to this machine, so
# binding it to a routable address is an explicit, deliberate act. Prefer
# putting it behind Tailscale/WireGuard rather than exposing 0.0.0.0.
#
# The container image sets HOST=0.0.0.0 instead, because inside a network
# namespace loopback means "unreachable" rather than "safe" — there, the
# deliberate act is publishing the port, and the compose file publishes it to
# 127.0.0.1 only. See README's "Running with Docker".
HOST=127.0.0.1
PORT=8787

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Generate with:  pnpm generate-token
# or:             node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Minimum 24 characters. The server refuses to start without it.
POCKETAGENT_AUTH_TOKEN=

# How long a browser stays signed in. Default 720h (30 days).
POCKETAGENT_SESSION_TTL_HOURS=720

# Auth cookie Secure flag. Defaults to true when NODE_ENV=production.
# Set to false if you deliberately serve over plain HTTP on a trusted VPN,
# otherwise the browser will discard the cookie and login will appear to fail.
#
# Worth knowing for containers: the image sets NODE_ENV=production, so this
# defaults to *true* there. Over plain HTTP on a tailnet that makes login look
# like it succeeded and then bounce straight back to the login screen, which is
# the most common first-run confusion. docker/compose.yaml sets it to false.
# POCKETAGENT_COOKIE_SECURE=true

# Comma-separated Origins allowed to call the API and open WebSockets.
# Leave unset for same-origin-only, which is correct for most deployments.
# POCKETAGENT_ALLOWED_ORIGINS=https://pocketagent.your-tailnet.ts.net

# Set to true only when running behind a reverse proxy you control, so that
# rate limiting sees the real client IP from X-Forwarded-For.
POCKETAGENT_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Project folders (optional seed)
# ---------------------------------------------------------------------------
# Comma-separated directories that sessions may run in.
#
# Optional, and only a *seed*: project folders live in the database and are
# managed from the app ("Add a project folder"), so this is read once against a
# fresh database and ignored afterwards. Editing it later will not fight, or
# undo, what you added in the UI.
#
# Unset simply means no folders yet; the app asks you to add one. It has never
# meant "the whole filesystem".
POCKETAGENT_WORKSPACE_ROOTS=/home/me/src

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_SESSIONS=10

# Per-session replay buffer. This is what a reconnecting phone catches up from.
OUTPUT_BUFFER_BYTES=2097152

# Auto-terminate a session after this many seconds with no output AND no
# attached browser. 0 disables it, which is the right default for long agent runs.
SESSION_IDLE_TIMEOUT=0

# ---------------------------------------------------------------------------
# Process backend
# ---------------------------------------------------------------------------
# Where agent processes actually live.
#
#   direct  (default) Agents are children of this server. Simple, no extra
#           dependency — but restarting PocketAgent kills every session.
#
#   tmux    Agents run inside a tmux server that outlives PocketAgent, so a
#           restart, crash, or `systemctl restart` leaves them running and they
#           are re-adopted on the next boot. Requires tmux installed.
#
# Sessions started under one backend are not visible to the other, so switching
# takes effect for new sessions only.
#
# In a container, use `direct`. The tmux backend still outlives a *server*
# restart inside the container, but the tmux server dies with the container, so
# it buys nothing across the restart you actually mean — and adopting the
# host's tmux needs its socket bind-mounted plus a matching uid.
POCKETAGENT_BACKEND=direct

# Only used when POCKETAGENT_BACKEND=tmux.
# A private socket keeps PocketAgent's tmux server separate from your own, and
# the config file is skipped so a stray .tmux.conf cannot rebind keys inside an
# agent session. Attach from a terminal with:
#   tmux -L pocketagent -f /dev/null attach -t pocketagent-<session-id>
POCKETAGENT_TMUX_BIN=tmux
POCKETAGENT_TMUX_SOCKET=pocketagent

# ---------------------------------------------------------------------------
# Attaching to your own tmux sessions (off by default)
# ---------------------------------------------------------------------------
# Set this to a tmux socket you own — `default` is the one a plain `tmux`
# command uses — and PocketAgent will offer to attach to panes running there,
# so an agent you started at your desk can be picked up from a phone. The
# "Shell" dialog can also start a brand-new *named* session on that same
# socket and attach to it immediately, so the reverse works too: create one
# from your phone, then `tmux -L <this socket> attach -t <name>` from your
# desk later.
#
# Only panes whose working directory resolves inside one of your project
# folders are ever offered, and every attach needs an explicit confirmation in the UI.
# Two things to understand before enabling it:
#
#   * It is your tmux server, with your config. Keys sent from the browser can
#     drive tmux itself, including your prefix.
#   * tmux sizes a window to its most recent client, so a phone attaching to a
#     desktop pane shrinks it until one of them detaches. PocketAgent joins at
#     the pane's current size and will not resize on its own.
#
# Leave empty to disable the feature entirely.
POCKETAGENT_ADOPT_TMUX_SOCKET=

# ---------------------------------------------------------------------------
# Global skip-permissions switch (off by default, DANGEROUS)
# ---------------------------------------------------------------------------
# PocketAgent's whole reason to exist is routing every tool-use approval to the
# browser. This turns that off for every session on this server at once,
# instead of the normal per-session, off-by-default `skipPermissions` opt-in
# offered when starting a session.
#
# When on: every newly created session (either transport) starts with
# approvals bypassed, and every currently running *structured* (native UI)
# session is switched over immediately, live. It does NOT reach a terminal
# session already running — `--dangerously-skip-permissions` is fixed at
# process spawn, so an existing one keeps asking until it is restarted.
#
# This is only a boot-time seed: once toggled at runtime (`PATCH
# /api/settings`), the database value wins on every later boot and this is
# ignored, exactly like POCKETAGENT_WORKSPACE_ROOTS. Turn it on only if you
# understand and accept that nothing on this server will ask you before
# running a command or editing a file.
POCKETAGENT_GLOBAL_SKIP_PERMISSIONS=false

# ---------------------------------------------------------------------------
# code-server (optional)
# ---------------------------------------------------------------------------
# Base URL of a code-server instance reachable from the browser, e.g.
# https://your-host/code/ . When set, every project row gets an "Open in
# code-server" action that deep-links to that project's folder
# (<base>?folder=<absolute-path>). code-server's own auth (password, or
# whatever you configured in ~/.config/code-server/config.yaml) still applies —
# this only builds the link, it does not change who can use it.
#
# Leave unset to hide the action entirely.
# POCKETAGENT_CODE_SERVER_URL=https://your-host/code/

# ---------------------------------------------------------------------------
# Voice input (PA-20)
# ---------------------------------------------------------------------------
# Base URL of the self-hosted live-stt service's HTTP admin port (not its gRPC
# port — this feature is HTTP-only). Reachable only from this server, never
# the browser: live-stt has no auth on its own HTTP/gRPC surface today.
#
# Leave unset to hide the mic button entirely. A set-but-invalid value fails
# the boot rather than the first tap of the mic. Only seeds the setting on
# first boot — editable from Settings after that (no restart needed), same
# as POCKETAGENT_CODE_SERVER_URL above.
# POCKETAGENT_LIVE_STT_URL=http://10.100.0.50:8000
#
# Optional model name for Speech-to-Text (e.g. whisper-large-v3-turbo-q8_0,
# realtime_eou_120m-v1). Leave unset to use live-stt's configured default model.
# POCKETAGENT_LIVE_STT_MODEL=
#
# Optional model name for Text-to-Speech (e.g. kokoro-82m-v1, piper-en-us).
# Leave unset to use live-stt's configured default model.
# POCKETAGENT_LIVE_STT_TTS_MODEL=

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Identifies this deployment to the browser's push service (VAPID `sub` claim).
# VAPID keys themselves are generated on first run and stored in the database.
# Push needs HTTPS; on iOS the site must be installed to the home screen first.
POCKETAGENT_PUSH_CONTACT=mailto:pocketagent@localhost

# ---------------------------------------------------------------------------
# Network discovery (PA-110)
# ---------------------------------------------------------------------------
# Announce this backend on the LAN over mDNS (`_pocketagent._tcp`), so a Hub on
# the same network lists it under "On this network" with a one-click Add.
# Off by default: exposing this server is a deliberate act, and announcing it
# to every machine on the network is a second one. It grants nothing — a Hub
# still needs this server's access token to bind it — and the advertisement
# carries only what /health already does (version and protocol range).
# Ignored, with a warning, while HOST is loopback: nothing else could reach it.
# mDNS does not cross routers. In Docker, containers on one network hear each
# other; host networking is only needed to reach machines on the LAN. With Docker
# Compose, set this in the service's `environment:` — a compose project's .env
# only fills ${...} in the compose file and is NOT passed into the container.
# POCKETAGENT_MDNS_ADVERTISE=false

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------
# Claude Code can run in two interfaces, chosen per session in the UI:
#   native   — chat bubbles, tool cards, diffs, tap-to-approve (Claude Agent SDK)
#   terminal — the real CLI in xterm.js, answered with keystrokes (node-pty)
# `shell` is terminal-only. See the README for the full trade-off.
# Defaults to $SHELL, falling back to /bin/bash.
# POCKETAGENT_SHELL=/bin/bash

# Claude Code executable, resolved on PATH.
POCKETAGENT_CLAUDE_BIN=claude

# Google Antigravity CLI executable, resolved on PATH. Structured transport
# only, and always runs with approvals bypassed — its headless mode has no
# synchronous approval channel to route to the browser. See apps/server/src/agents/agy.ts.
POCKETAGENT_AGY_BIN=agy

# opencode CLI executable, resolved on PATH. Structured transport only, served
# headlessly (one shared `opencode serve` process for every opencode session —
# see apps/server/src/sessions/opencode-server.ts). Unlike agy, this one has a
# real approval gate, so skip-permissions here is an actual per-session choice.
POCKETAGENT_OPENCODE_BIN=opencode

# OpenAI Codex CLI executable, resolved on PATH. Structured transport only,
# driven through `codex app-server`'s JSON-RPC protocol (one shared process
# for every codex session — see apps/server/src/sessions/codex-server.ts).
# Also has a real approval gate. That protocol is marked [experimental] by
# OpenAI and its schema shows signs of an in-flight migration; expect it to
# need upkeep across Codex CLI updates.
POCKETAGENT_CODEX_BIN=codex

# pi (@earendil-works/pi-coding-agent) executable, resolved on PATH.
# Structured transport only, driven through `pi --mode rpc`. Always runs
# with approvals bypassed, and unlike agy this is not a limit of one mode —
# pi has no approval/sandbox concept anywhere, by explicit design. See
# apps/server/src/agents/pi.ts.
POCKETAGENT_PI_BIN=pi

# "Set up agents" (PA-68) installs each agent CLI with its vendor's official
# installer, into the vendor's official location — ~/.local/bin (claude,
# codex, agy, pi), ~/.opencode/bin (opencode) — so the server runs the same
# binary your own login shell does (PA-104). Installing downloads that
# installer from a fixed https:// URL and runs it as the server's user, which
# is arbitrary code execution by design: only the ids in
# GET /api/agents/installable can ever be installed, and only when someone
# presses the button.
#
# This prefix is only for npm-method installs, which no current agent uses,
# and it is where installs from before PA-104 left copies. The server searches
# it *last*, so a copy here never shadows an official one; Settings lists such
# copies and can remove them.
# POCKETAGENT_AGENT_INSTALL_PREFIX=~/.npm-global

# ---------------------------------------------------------------------------
# Claude Code against a third-party model (PA-19, PA-28)
# ---------------------------------------------------------------------------
# When the Anthropic account hits its rate limit, a Claude Code conversation is
# stuck. A "custom Claude provider" runs the *same* `claude` binary against an
# Anthropic-compatible third-party endpoint, so a stopped conversation can be
# continued from the same transcript — Claude Code derives the transcript path
# from the cwd, not from which API it talked to, so `forkSession: false`
# appends the new turns to the same `.jsonl`.
#
# As of PA-28 these are NOT configured here. They are created and edited in the
# app, under Settings -> Custom Claude Providers, and stored in the database
# with their API key encrypted at rest. Adding, editing or removing one takes
# effect immediately, with no restart. The only setting this file still needs is
# the encryption key below.
#
# SECURITY: creating one of these routes prompts and repository contents to a
# third party, which the `claude` adapter has never done. The session says so
# persistently in the UI. Per-session cost figures are also wrong while one is
# in use, since they are computed with Anthropic's price list. A provider is
# also refused by scheduled jobs and inbound webhooks unless its own
# "allow unattended use" toggle is on — off by default, per provider.

# Base64 of 32 random bytes. Encrypts each custom Claude provider's API key in
# `data/pocketagent.db` (AES-256-GCM; see apps/server/src/crypto/secret-box.ts).
# Generate one with:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Unset is safe and does not stop the server: the custom-provider feature is
# simply disabled, and Settings says which variable to set. Set-but-invalid is
# a boot error, since a typo would otherwise silently turn off a feature you
# believe you just enabled. Do NOT rotate this without first re-entering every
# provider's key — a row encrypted with the old key cannot be decrypted with a
# new one, and the provider greys out until its key is re-entered.
# POCKETAGENT_SETTINGS_ENC_KEY=

# DEPRECATED, read exactly once and then ignored forever (PA-28).
#
# These were how the two former built-in variants (`claude-deepseek`,
# `claude-omniroute`) were configured. If any of them is still set on the first
# boot after upgrading — and POCKETAGENT_SETTINGS_ENC_KEY is set, since the key
# has to be encrypted with something — the server imports one custom Claude
# provider row per configured variant, logs a deprecation warning, and records
# that it has done so. After that these variables are never read again, and you
# can delete them. Manage the imported provider from Settings instead; deleting
# it there is permanent and will not be undone by these still being present.
#
# If POCKETAGENT_SETTINGS_ENC_KEY is NOT set, the import is deferred rather than
# skipped: generate a key, restart, and it happens on that boot.
#
# Note the agent id changes on import (`claude-deepseek` becomes
# `custom-claude:deepseek`), so an old chat's row keeps naming the old id and
# can no longer be continued on it — start a new chat, or continue that
# conversation on the imported provider from the "Continue as…" picker.
# POCKETAGENT_DEEPSEEK_API_KEY=sk-...
# POCKETAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# POCKETAGENT_DEEPSEEK_MODEL=deepseek-v4-pro
# POCKETAGENT_DEEPSEEK_SMALL_MODEL=deepseek-v4-flash
# POCKETAGENT_DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
# POCKETAGENT_OMNIROUTE_API_KEY=sk-...
# POCKETAGENT_OMNIROUTE_BASE_URL=https://omniroute.example.internal
# POCKETAGENT_OMNIROUTE_MODEL=deepseek-v4-pro
# POCKETAGENT_OMNIROUTE_SMALL_MODEL=deepseek-v4-flash
# POCKETAGENT_OMNIROUTE_MODELS=deepseek-v4-pro,deepseek-v4-flash

# ---------------------------------------------------------------------------
# Data root
# ---------------------------------------------------------------------------
# Where every mutable, app-owned directory lives (PA-62):
#
#     $POCKETAGENT_DATA_DIR/pocketagent.db
#     $POCKETAGENT_DATA_DIR/planner-workspaces/
#     $POCKETAGENT_DATA_DIR/planner-skills/
#
# Unset means `<checkout>/data`, which is exactly what every install used
# before this variable existed — leave it alone unless you have a reason.
#
# The reason it exists is a containerised backend: the checkout is in the
# image and the state has to outlive it, so all of the above has to be able
# to move onto one mounted volume together.
#
# Two rules, because making this configurable removed a guarantee that used to
# be structural (a scratch server *could not* be pointed at the real database,
# because the path was always inside the checkout it ran from):
#
#   - It is refused if it resolves inside a project folder. The database holds
#     webhook signing secrets and encrypted provider API keys, and an agent
#     working in that tree can rewrite or delete it. A project folder *inside*
#     the data root is fine — one volume holding both repos and state is a
#     reasonable container layout.
#   - Every boot logs the data root it opened. If a demo or scratch server
#     looks like it has someone else's chats, read that line first.
#
# Demo scripts (`pnpm demo:*` with PA_BASE) should set this to a throwaway
# directory outside every project folder. That is now how a scratch server
# isolates itself, instead of running from a second checkout.
#
# Containers: mount every project folder at the *same absolute path* it has on
# the host. Claude Code derives its transcript directory name from the cwd, so
# a repo mounted elsewhere makes every existing conversation undiscoverable —
# silently, with an empty history rather than an error. See the README.
# POCKETAGENT_DATA_DIR=/var/lib/pocketagent

# ---------------------------------------------------------------------------
# Built web bundle
# ---------------------------------------------------------------------------
# Directory `@fastify/static` serves the frontend from. Unset means
# `<checkout>/apps/web/dist`, which is where `pnpm build` puts it, so a normal
# install never needs this.
#
# The container image sets it explicitly (`/app/apps/web/dist`) so the bundle's
# location is a stated contract rather than something inferred from where this
# file happens to sit on disk. Note a *relative* value resolves against the
# process's cwd, not the checkout.
#
# If the directory does not exist, the server still starts and serves the API —
# it answers page requests with a plain "the web UI has not been built" 404
# instead of pretending. index.html is read once at boot, so a rebuilt bundle
# needs a restart to be served.
# POCKETAGENT_WEB_DIST=/app/apps/web/dist

# ---------------------------------------------------------------------------
# Build identity
# ---------------------------------------------------------------------------
# Semver this build reports on `/health` and `HostInfo.version` (PA-61).
#
# Normally set by the image build, not by hand: it is build identity rather
# than configuration, so it is read from raw `process.env` and never appears in
# the settings UI. Unset falls back to this package's `package.json` version,
# then to `0.0.0-dev`. A value that is not valid semver is ignored with a
# warning at boot rather than failing the start — but a whole fleet then
# reports the checkout's version, and version-drift detection stops being able
# to tell the hosts apart.
# POCKETAGENT_BUILD_VERSION=1.4.2

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development

# ---------------------------------------------------------------------------
# PocketAgent Hub (PA-66)
# ---------------------------------------------------------------------------
# Only read by `apps/hub`, the optional one-origin gateway that fronts several
# backends. A backend ignores every variable in this block, and running one
# without a Hub is unchanged in every respect.
#
# Run it with:  pnpm -F @pocketagent/hub dev   (or the pocketagent-hub image)
# It is deliberately not part of `pnpm dev`: most work here is against a single
# backend, and a Hub with no hosts registered has nothing to show.

# Required. The Hub's *own* operator credential, min 24 chars.
#
# Deliberately NOT POCKETAGENT_AUTH_TOKEN. A Hub never holds a backend's master
# token — it exchanges one, once, for a revocable credential and discards it —
# so reusing the variable would put back exactly the permanent root credential
# that design removes, and would make one paste into the Hub's login box also
# root on that machine.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# POCKETAGENT_HUB_AUTH_TOKEN=

# Required by the Hub, unlike on a backend where leaving it unset merely
# disables optional features. Every backend credential the Hub stores is
# encrypted with this key and read back to make requests, so a Hub without one
# has nothing it can do; it refuses to boot rather than deferring the failure
# to your first bind. Losing it does not lose access — re-bind each host and
# revoke the orphaned credentials from each backend's Settings → Hubs.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# POCKETAGENT_SETTINGS_ENC_KEY=

# POCKETAGENT_HUB_HOST=127.0.0.1
# POCKETAGENT_HUB_PORT=8788

# The Hub's registry and its encrypted credentials. Its own variable rather
# than POCKETAGENT_DATA_DIR, because one name for two unrelated schemas is a
# trap in the one deployment where it matters — a compose file running a Hub
# and a backend side by side. Default: <checkout>/data/hub
# POCKETAGENT_HUB_DATA_DIR=/var/lib/pocketagent-hub

# How long a Hub login lasts. Same meaning as the backend's own setting.
# POCKETAGENT_HUB_SESSION_TTL_HOURS=720

# Advertised to the browser as the newest release that exists, for the
# version-drift badge (PA-69). Unset, the UI infers it from the hosts it can
# see — evidence rather than authority. The Hub never queries a release feed.
# POCKETAGENT_HUB_LATEST_RELEASE=

# Identifies the Hub to the browser's push service (VAPID `sub` claim) for
# web push notifications relayed from bound hosts (PA-73).
# POCKETAGENT_HUB_PUSH_CONTACT=mailto:pocketagent@localhost

# Listen for backends advertising themselves over mDNS (their
# POCKETAGENT_MDNS_ADVERTISE), and list them on the Hub page as suggestions to
# add (PA-110). On by default — hearing an advertisement discloses and grants
# nothing, and adding one is still the ordinary add-then-bind. Set false to stop
# the Hub opening UDP 5353 at all. A Hub in a container hears backends on its own
# Docker network; hearing the LAN needs host networking. If the socket cannot be
# opened the Hub page says so and everything else works as before.
# POCKETAGENT_HUB_MDNS=true

# POCKETAGENT_ALLOWED_ORIGINS, POCKETAGENT_COOKIE_SECURE and
# POCKETAGENT_TRUST_PROXY mean the same thing for the Hub as for a backend, and
# matter more: the Hub is the one origin the browser talks to, so it is where
# TLS is terminated and where the CSRF Origin check now lives.
