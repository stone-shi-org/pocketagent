# PocketAgent configuration
# Copy to `.env` and edit. Never commit the real file.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Loopback by default. PocketAgent grants terminal access to this machine, so
# binding it to a routable address is an explicit, deliberate act. Prefer
# putting it behind Tailscale/WireGuard rather than exposing 0.0.0.0.
HOST=127.0.0.1
PORT=8787

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Generate with:  pnpm generate-token
# or:             node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Minimum 24 characters. The server refuses to start without it.
POCKETAGENT_AUTH_TOKEN=

# How long a browser stays signed in. Default 720h (30 days).
POCKETAGENT_SESSION_TTL_HOURS=720

# Auth cookie Secure flag. Defaults to true when NODE_ENV=production.
# Set to false if you deliberately serve over plain HTTP on a trusted VPN,
# otherwise the browser will discard the cookie and login will appear to fail.
# POCKETAGENT_COOKIE_SECURE=true

# Comma-separated Origins allowed to call the API and open WebSockets.
# Leave unset for same-origin-only, which is correct for most deployments.
# POCKETAGENT_ALLOWED_ORIGINS=https://pocketagent.your-tailnet.ts.net

# Set to true only when running behind a reverse proxy you control, so that
# rate limiting sees the real client IP from X-Forwarded-For.
POCKETAGENT_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Workspaces (required)
# ---------------------------------------------------------------------------
# Comma-separated directories that sessions may run in. A requested working
# directory is resolved through symlinks and must land inside one of these.
# There is no default: unset must never mean "the whole filesystem".
POCKETAGENT_WORKSPACE_ROOTS=/home/me/src

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Session metadata only. No terminal output is ever written here.
DATABASE_PATH=./data/pocketagent.db

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_SESSIONS=10

# Per-session replay buffer. This is what a reconnecting phone catches up from.
OUTPUT_BUFFER_BYTES=2097152

# Auto-terminate a session after this many seconds with no output AND no
# attached browser. 0 disables it, which is the right default for long agent runs.
SESSION_IDLE_TIMEOUT=0

# ---------------------------------------------------------------------------
# Process backend
# ---------------------------------------------------------------------------
# Where agent processes actually live.
#
#   direct  (default) Agents are children of this server. Simple, no extra
#           dependency — but restarting PocketAgent kills every session.
#
#   tmux    Agents run inside a tmux server that outlives PocketAgent, so a
#           restart, crash, or `systemctl restart` leaves them running and they
#           are re-adopted on the next boot. Requires tmux installed.
#
# Sessions started under one backend are not visible to the other, so switching
# takes effect for new sessions only.
POCKETAGENT_BACKEND=direct

# Only used when POCKETAGENT_BACKEND=tmux.
# A private socket keeps PocketAgent's tmux server separate from your own, and
# the config file is skipped so a stray .tmux.conf cannot rebind keys inside an
# agent session. Attach from a terminal with:
#   tmux -L pocketagent -f /dev/null attach -t pocketagent-<session-id>
POCKETAGENT_TMUX_BIN=tmux
POCKETAGENT_TMUX_SOCKET=pocketagent

# ---------------------------------------------------------------------------
# Attaching to your own tmux sessions (off by default)
# ---------------------------------------------------------------------------
# Set this to a tmux socket you own — `default` is the one a plain `tmux`
# command uses — and PocketAgent will offer to attach to panes running there,
# so an agent you started at your desk can be picked up from a phone.
#
# Only panes whose working directory resolves inside POCKETAGENT_WORKSPACE_ROOTS
# are ever offered, and every attach needs an explicit confirmation in the UI.
# Two things to understand before enabling it:
#
#   * It is your tmux server, with your config. Keys sent from the browser can
#     drive tmux itself, including your prefix.
#   * tmux sizes a window to its most recent client, so a phone attaching to a
#     desktop pane shrinks it until one of them detaches. PocketAgent joins at
#     the pane's current size and will not resize on its own.
#
# Leave empty to disable the feature entirely.
POCKETAGENT_ADOPT_TMUX_SOCKET=

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Identifies this deployment to the browser's push service (VAPID `sub` claim).
# VAPID keys themselves are generated on first run and stored in the database.
# Push needs HTTPS; on iOS the site must be installed to the home screen first.
POCKETAGENT_PUSH_CONTACT=mailto:pocketagent@localhost

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------
# Claude Code can run in two interfaces, chosen per session in the UI:
#   native   — chat bubbles, tool cards, diffs, tap-to-approve (Claude Agent SDK)
#   terminal — the real CLI in xterm.js, answered with keystrokes (node-pty)
# `shell` is terminal-only. See the README for the full trade-off.
# Defaults to $SHELL, falling back to /bin/bash.
# POCKETAGENT_SHELL=/bin/bash

# Claude Code executable, resolved on PATH.
POCKETAGENT_CLAUDE_BIN=claude

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
