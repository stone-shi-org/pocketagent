# PocketAgent configuration
# Copy to `.env` and edit. Never commit the real file.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Loopback by default. PocketAgent grants terminal access to this machine, so
# binding it to a routable address is an explicit, deliberate act. Prefer
# putting it behind Tailscale/WireGuard rather than exposing 0.0.0.0.
HOST=127.0.0.1
PORT=8787

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Generate with:  pnpm generate-token
# or:             node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Minimum 24 characters. The server refuses to start without it.
POCKETAGENT_AUTH_TOKEN=

# How long a browser stays signed in. Default 720h (30 days).
POCKETAGENT_SESSION_TTL_HOURS=720

# Auth cookie Secure flag. Defaults to true when NODE_ENV=production.
# Set to false if you deliberately serve over plain HTTP on a trusted VPN,
# otherwise the browser will discard the cookie and login will appear to fail.
# POCKETAGENT_COOKIE_SECURE=true

# Comma-separated Origins allowed to call the API and open WebSockets.
# Leave unset for same-origin-only, which is correct for most deployments.
# POCKETAGENT_ALLOWED_ORIGINS=https://pocketagent.your-tailnet.ts.net

# Set to true only when running behind a reverse proxy you control, so that
# rate limiting sees the real client IP from X-Forwarded-For.
POCKETAGENT_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Project folders (optional seed)
# ---------------------------------------------------------------------------
# Comma-separated directories that sessions may run in.
#
# Optional, and only a *seed*: project folders live in the database and are
# managed from the app ("Add a project folder"), so this is read once against a
# fresh database and ignored afterwards. Editing it later will not fight, or
# undo, what you added in the UI.
#
# Unset simply means no folders yet; the app asks you to add one. It has never
# meant "the whole filesystem".
POCKETAGENT_WORKSPACE_ROOTS=/home/me/src

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_SESSIONS=10

# Per-session replay buffer. This is what a reconnecting phone catches up from.
OUTPUT_BUFFER_BYTES=2097152

# Auto-terminate a session after this many seconds with no output AND no
# attached browser. 0 disables it, which is the right default for long agent runs.
SESSION_IDLE_TIMEOUT=0

# ---------------------------------------------------------------------------
# Process backend
# ---------------------------------------------------------------------------
# Where agent processes actually live.
#
#   direct  (default) Agents are children of this server. Simple, no extra
#           dependency — but restarting PocketAgent kills every session.
#
#   tmux    Agents run inside a tmux server that outlives PocketAgent, so a
#           restart, crash, or `systemctl restart` leaves them running and they
#           are re-adopted on the next boot. Requires tmux installed.
#
# Sessions started under one backend are not visible to the other, so switching
# takes effect for new sessions only.
POCKETAGENT_BACKEND=direct

# Only used when POCKETAGENT_BACKEND=tmux.
# A private socket keeps PocketAgent's tmux server separate from your own, and
# the config file is skipped so a stray .tmux.conf cannot rebind keys inside an
# agent session. Attach from a terminal with:
#   tmux -L pocketagent -f /dev/null attach -t pocketagent-<session-id>
POCKETAGENT_TMUX_BIN=tmux
POCKETAGENT_TMUX_SOCKET=pocketagent

# ---------------------------------------------------------------------------
# Attaching to your own tmux sessions (off by default)
# ---------------------------------------------------------------------------
# Set this to a tmux socket you own — `default` is the one a plain `tmux`
# command uses — and PocketAgent will offer to attach to panes running there,
# so an agent you started at your desk can be picked up from a phone. The
# "Shell" dialog can also start a brand-new *named* session on that same
# socket and attach to it immediately, so the reverse works too: create one
# from your phone, then `tmux -L <this socket> attach -t <name>` from your
# desk later.
#
# Only panes whose working directory resolves inside one of your project
# folders are ever offered, and every attach needs an explicit confirmation in the UI.
# Two things to understand before enabling it:
#
#   * It is your tmux server, with your config. Keys sent from the browser can
#     drive tmux itself, including your prefix.
#   * tmux sizes a window to its most recent client, so a phone attaching to a
#     desktop pane shrinks it until one of them detaches. PocketAgent joins at
#     the pane's current size and will not resize on its own.
#
# Leave empty to disable the feature entirely.
POCKETAGENT_ADOPT_TMUX_SOCKET=

# ---------------------------------------------------------------------------
# Global skip-permissions switch (off by default, DANGEROUS)
# ---------------------------------------------------------------------------
# PocketAgent's whole reason to exist is routing every tool-use approval to the
# browser. This turns that off for every session on this server at once,
# instead of the normal per-session, off-by-default `skipPermissions` opt-in
# offered when starting a session.
#
# When on: every newly created session (either transport) starts with
# approvals bypassed, and every currently running *structured* (native UI)
# session is switched over immediately, live. It does NOT reach a terminal
# session already running — `--dangerously-skip-permissions` is fixed at
# process spawn, so an existing one keeps asking until it is restarted.
#
# This is only a boot-time seed: once toggled at runtime (`PATCH
# /api/settings`), the database value wins on every later boot and this is
# ignored, exactly like POCKETAGENT_WORKSPACE_ROOTS. Turn it on only if you
# understand and accept that nothing on this server will ask you before
# running a command or editing a file.
POCKETAGENT_GLOBAL_SKIP_PERMISSIONS=false

# ---------------------------------------------------------------------------
# code-server (optional)
# ---------------------------------------------------------------------------
# Base URL of a code-server instance reachable from the browser, e.g.
# https://your-host/code/ . When set, every project row gets an "Open in
# code-server" action that deep-links to that project's folder
# (<base>?folder=<absolute-path>). code-server's own auth (password, or
# whatever you configured in ~/.config/code-server/config.yaml) still applies —
# this only builds the link, it does not change who can use it.
#
# Leave unset to hide the action entirely.
# POCKETAGENT_CODE_SERVER_URL=https://your-host/code/

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Identifies this deployment to the browser's push service (VAPID `sub` claim).
# VAPID keys themselves are generated on first run and stored in the database.
# Push needs HTTPS; on iOS the site must be installed to the home screen first.
POCKETAGENT_PUSH_CONTACT=mailto:pocketagent@localhost

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------
# Claude Code can run in two interfaces, chosen per session in the UI:
#   native   — chat bubbles, tool cards, diffs, tap-to-approve (Claude Agent SDK)
#   terminal — the real CLI in xterm.js, answered with keystrokes (node-pty)
# `shell` is terminal-only. See the README for the full trade-off.
# Defaults to $SHELL, falling back to /bin/bash.
# POCKETAGENT_SHELL=/bin/bash

# Claude Code executable, resolved on PATH.
POCKETAGENT_CLAUDE_BIN=claude

# Google Antigravity CLI executable, resolved on PATH. Structured transport
# only, and always runs with approvals bypassed — its headless mode has no
# synchronous approval channel to route to the browser. See apps/server/src/agents/agy.ts.
POCKETAGENT_AGY_BIN=agy

# opencode CLI executable, resolved on PATH. Structured transport only, served
# headlessly (one shared `opencode serve` process for every opencode session —
# see apps/server/src/sessions/opencode-server.ts). Unlike agy, this one has a
# real approval gate, so skip-permissions here is an actual per-session choice.
POCKETAGENT_OPENCODE_BIN=opencode

# OpenAI Codex CLI executable, resolved on PATH. Structured transport only,
# driven through `codex app-server`'s JSON-RPC protocol (one shared process
# for every codex session — see apps/server/src/sessions/codex-server.ts).
# Also has a real approval gate. That protocol is marked [experimental] by
# OpenAI and its schema shows signs of an in-flight migration; expect it to
# need upkeep across Codex CLI updates.
POCKETAGENT_CODEX_BIN=codex

# pi (@earendil-works/pi-coding-agent) executable, resolved on PATH.
# Structured transport only, driven through `pi --mode rpc`. Always runs
# with approvals bypassed, and unlike agy this is not a limit of one mode —
# pi has no approval/sandbox concept anywhere, by explicit design. See
# apps/server/src/agents/pi.ts.
POCKETAGENT_PI_BIN=pi

# ---------------------------------------------------------------------------
# Claude Code against a third-party model (PA-19)
# ---------------------------------------------------------------------------
# When the Anthropic account hits its rate limit, a Claude Code conversation is
# stuck. These variants run the *same* `claude` binary against an
# Anthropic-compatible third-party endpoint, so a stopped conversation can be
# continued from the same transcript — Claude Code derives the transcript path
# from the cwd, not from which API it talked to, so `forkSession: false`
# appends the new turns to the same `.jsonl`.
#
# Each variant is off until its API key is set: the entry then appears in the
# agent list, greyed out until then rather than failing at spawn. Nothing here
# changes stock `claude`, and neither variant can be used by a scheduled job or
# an inbound webhook — those unattended paths reject it at the route, and
# widening them is a separate decision.
#
# SECURITY: turning one of these on routes prompts and repository contents to a
# third party, which the `claude` adapter has never done. The session says so
# persistently in the UI. Per-session cost figures are also wrong while one is
# in use, since they are computed with Anthropic's price list.

# DeepSeek directly. The base URL defaults to DeepSeek's own Anthropic-compatible
# route, so normally only the key is needed.
# POCKETAGENT_DEEPSEEK_API_KEY=sk-...
# POCKETAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# POCKETAGENT_DEEPSEEK_MODEL=deepseek-v4-pro
# Claude Code uses a small model for titles and compaction summaries. Defaulted
# explicitly to the cheap model rather than to the main one, since it runs often.
# An id the provider does not know fails *mid-session*, not at spawn.
# POCKETAGENT_DEEPSEEK_SMALL_MODEL=deepseek-v4-flash
# Comma-separated catalog for the model picker. The CLI reports Anthropic's
# catalog whatever the base URL is, so this replaces it. Take the ids from
# DeepSeek's own `GET /models` — the retired `deepseek-chat`/`deepseek-reasoner`
# aliases still resolve, but BOTH serve `deepseek-v4-flash`, so listing them
# offers one model twice under two names.
# POCKETAGENT_DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash

# A gateway speaking the Anthropic Messages API (e.g. omniroute). No base URL
# is guessed here — a gateway address is per-installation.
# POCKETAGENT_OMNIROUTE_API_KEY=sk-...
# POCKETAGENT_OMNIROUTE_BASE_URL=https://omniroute.example.internal
# POCKETAGENT_OMNIROUTE_MODEL=deepseek-v4-pro
# POCKETAGENT_OMNIROUTE_SMALL_MODEL=deepseek-v4-flash
# Take these ids from the gateway's own /models — a gateway may reject a
# provider's native id as ambiguous and want its own.
# POCKETAGENT_OMNIROUTE_MODELS=deepseek-v4-pro,deepseek-v4-flash

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
