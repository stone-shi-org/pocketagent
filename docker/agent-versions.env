# Agent CLI versions pinned into the `claude` and `all` image targets (PA-64).
#
# One file, read by `docker/build.sh` and by CI (PA-65), so bumping a pin is a
# one-line change in one place rather than an edit to a Dockerfile plus an edit
# to a pipeline. The Dockerfile itself declares these as ARGs with no defaults
# and fails the build when one is empty, which is what keeps this file
# authoritative instead of merely advisory.
#
# These pins are the whole reason the `-all` tag exists (air-gapped and
# byte-reproducible installs). They are *not* meant to be current: agent CLIs
# release far faster than this app, which is exactly why the thin image ships
# none of them and PA-68 installs on demand into the mounted agent prefix.

# https://www.npmjs.com/package/@anthropic-ai/claude-code
CLAUDE_CODE_VERSION=2.1.274

# https://www.npmjs.com/package/@openai/codex
CODEX_VERSION=0.154.0

# https://www.npmjs.com/package/opencode-ai
OPENCODE_VERSION=1.18.31

# https://www.npmjs.com/package/@earendil-works/pi-coding-agent
PI_VERSION=0.85.1

# Deliberately absent: `agy`, Google's Antigravity CLI. It is distributed as a
# Google-published binary and has no npm package; the registry names that look
# right (`agy`, `antigravity-cli`) are unrelated 0.0.x placeholders, so pinning
# one would be a supply-chain hazard disguised as completeness. Install it into
# the mounted agent prefix instead.
