# Variables docker/compose.yaml and docker/compose.hub.yaml interpolate.
# Copy to docker/.env and edit.
#
# This is not the same file as the repo root's .env, and compose deliberately
# does not read that one: it sets HOST=127.0.0.1, which inside a container
# means the server answers nothing.

# Required, minimum 24 characters. Generate one for *this* deployment — one
# token on two hosts means one leak costs you both:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
POCKETAGENT_AUTH_TOKEN=

# The directory holding your repositories, as an absolute host path. It is
# mounted at the SAME path inside the container and seeds the project-folder
# list. A remapped mount makes existing Claude Code conversations
# undiscoverable — see the comment on the volume in compose.yaml.
PA_WORKSPACE_ROOT=/home/me/src

# The host user that owns PA_WORKSPACE_ROOT. `id -u` / `id -g`.
PUID=1000
PGID=1000

# Optional. Encrypts custom Claude provider API keys and Telegram bot tokens
# at rest; unset disables those features rather than failing the boot.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# POCKETAGENT_SETTINGS_ENC_KEY=

# ---------------------------------------------------------------------------
# Only for docker/compose.hub.yaml (PA-66)
# ---------------------------------------------------------------------------
# compose.yaml ignores everything below; the backend does not read any of it.

# Required by the Hub. Its *own* operator credential — deliberately not any
# backend's POCKETAGENT_AUTH_TOKEN above, because reusing one would make a
# paste into the Hub's login box also a root credential for that machine.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# POCKETAGENT_HUB_AUTH_TOKEN=

# POCKETAGENT_SETTINGS_ENC_KEY (above) is *optional* for a backend and
# *required* for the Hub: it encrypts every backend credential the Hub stores,
# so a Hub without one has nothing it can do and refuses to boot.

# Access tokens for the two example backends in compose.hub.yaml. One each —
# they are separate machines as far as the Hub is concerned, and the whole
# point of binding is that the Hub does not keep either of these afterwards.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PA_DEV01_TOKEN=
# PA_DEV02_TOKEN=
